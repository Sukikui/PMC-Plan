# Complete local development configuration for contributors.
# Copy this file to .env.development.local and replace every placeholder below.

# =====================================================================================
# Application configuration
# =====================================================================================

NEXT_PUBLIC_BETA_PASSWORD=beta
NEXT_PUBLIC_DISABLE_BETA_LOCK=true
MINECRAFT_VERSION=26.1.2

# =====================================================================================
# Auth.js and Discord OAuth
# =====================================================================================

AUTH_URL=http://localhost:3000
AUTH_SECRET=your-local-auth-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# =====================================================================================
# Database connections
# Docker Compose manages this isolated database. Do not change these URLs.
# =====================================================================================

DATABASE_URL=postgresql://pmc_plan:pmc_plan@localhost:5432/pmc_plan_dev
POSTGRES_URL_NON_POOLING=postgresql://pmc_plan:pmc_plan@localhost:5432/pmc_plan_dev

# =====================================================================================
# MineVerify integration
# =====================================================================================

MINEVERIFY_TOKEN=your-local-mineverify-token

# =====================================================================================
# Database snapshot
# A maintainer supplies this private signed URL. Keep the quotes.
# =====================================================================================

DEV_DATABASE_SNAPSHOT_URL="https://project.supabase.co/storage/v1/object/sign/bucket/path?token=token"

# =====================================================================================
# Development identity
# This Discord account becomes Super Admin after each local restoration.
# =====================================================================================

DEV_DISCORD_ID=your-discord-user-id
