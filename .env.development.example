# Local overrides loaded after .env.local in development.
# Keep shared application secrets in .env.local and override only local services here.
DATABASE_URL=postgresql://pmc_plan:pmc_plan@localhost:5432/pmc_plan_dev
POSTGRES_URL_NON_POOLING=postgresql://pmc_plan:pmc_plan@localhost:5432/pmc_plan_dev

# Private signed URL supplied by a maintainer. Keep the quotes.
DEV_DATABASE_SNAPSHOT_URL="https://project.supabase.co/storage/v1/object/sign/bucket/path?token=token"

# Per-developer token shared only with the local MineVerify plugin.
# Generate with: openssl rand -base64 32
MINEVERIFY_TOKEN=your-local-mineverify-token

# Discord account promoted to Super Admin after each local restoration.
DEV_DISCORD_ID=your-discord-user-id
