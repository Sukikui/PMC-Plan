# Complete application environment reference for maintainers and deployment.
# Contributors use .env.development.local.example instead.
# A maintainer may copy this file to .env.local; Vercel stores the corresponding
# production values in its environment configuration rather than in this file.

# =====================================================================================
# Application configuration
# =====================================================================================

NEXT_PUBLIC_BETA_PASSWORD=your-beta-password
NEXT_PUBLIC_DISABLE_BETA_LOCK=false
MINECRAFT_VERSION=26.1.2

# =====================================================================================
# Auth.js and Discord OAuth
# =====================================================================================

AUTH_URL=https://pmc-plan.vercel.app
AUTH_SECRET=your-production-auth-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# =====================================================================================
# Database connections
# Production uses the pooled URL at runtime and the direct URL for Prisma tasks.
# =====================================================================================

DATABASE_URL=postgresql://user:password@pooled-production-host:5432/postgres
POSTGRES_URL_NON_POOLING=postgresql://user:password@direct-production-host:5432/postgres

# =====================================================================================
# MineVerify integration
# =====================================================================================

MINEVERIFY_TOKEN=your-deployed-mineverify-token

# =====================================================================================
# Database snapshot
# These maintainer-only values publish the development baseline to Supabase Storage.
# =====================================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_SNAPSHOT_BUCKET=development-snapshots
DATABASE_SNAPSHOT_OBJECT=pmc-plan/development-baseline.dump
DATABASE_SNAPSHOT_URL_TTL_SECONDS=31536000
