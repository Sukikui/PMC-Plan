# Environment variables configuration for PMC Plan
# Copy this file to .env.local and modify the values according to your needs

# =============================================================================
# BETA LOCK SCREEN CONFIGURATION
# =============================================================================

# Password to access the application in beta mode
# Default: "beta" if not defined
NEXT_PUBLIC_BETA_PASSWORD=beta

# Completely disable the beta lock screen
# Possible values: "true" to disable, any other value to enable
# Default: enabled if not defined
NEXT_PUBLIC_DISABLE_BETA_LOCK=false

# =============================================================================
# MINECRAFT API CONFIGURATION
# =============================================================================

# Minecraft version to use for items/blocks data
# Examples: "1.21.1", "1.20.1", "latest"
# Default: "latest" if not defined
MINECRAFT_VERSION=26.1.2

# =============================================================================
# MINEVERIFY CONFIGURATION
# =============================================================================

# Bearer token used by deployed MineVerify instances.
# Local development overrides it through .env.development.local.
MINEVERIFY_TOKEN=your-mineverify-token

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Local development overrides these two values through .env.development.local.
# Keep this file complete so all non-database configuration remains available.

# PostgreSQL database connection string
# For local development with Supabase:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local PostgreSQL:
# postgresql://user:password@localhost:5432/pmc_plan
DATABASE_URL=postgresql://localhost:5432/pmc_plan

# Direct PostgreSQL connection used by Prisma schema operations
POSTGRES_URL_NON_POOLING=postgresql://localhost:5432/pmc_plan

# Maintainer-only configuration used by npm run db:snapshot:publish.
# Contributors only receive DEV_DATABASE_SNAPSHOT_URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_SNAPSHOT_BUCKET=development-snapshots
DATABASE_SNAPSHOT_OBJECT=pmc-plan/development-baseline.dump
# Signed download URL validity in seconds (default: one year).
DATABASE_SNAPSHOT_URL_TTL_SECONDS=31536000

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================

# Application URL (full URL with scheme)
AUTH_URL=http://localhost:3000
# Secret for JWT signing and encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here

# =============================================================================
# DISCORD OAUTH (required for "Se connecter avec Discord")
# =============================================================================

# Create an application at https://discord.com/developers/applications
# Add a Redirect URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
