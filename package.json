{
  "name": "pmc-plan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "dotenv -e .env.development.local -o -- node scripts/database/assert-local.mjs && next dev",
    "dev:setup": "npm run db:start && npm run db:generate && npm run db:pull",
    "build": "dotenv -e .env.development.local -o -- node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "type-check": "npm run typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:unused": "knip && knip --production --config knip.production.json",
    "check:security": "npm audit --audit-level=high",
    "check:quality": "npm run check:security && npm run lint && npm run type-check && npm run check:unused && npm run test:coverage",
    "db:start": "docker compose up -d --wait database",
    "db:stop": "docker compose stop database",
    "db:generate": "dotenv -e .env.development.local -o -- node scripts/database/run-local-prisma.mjs generate",
    "db:apply": "dotenv -e .env.development.local -o -- node scripts/database/run-local-prisma.mjs migrate deploy",
    "db:check": "dotenv -e .env.development.local -o -- node scripts/database/run-local-prisma.mjs migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:migrate": "dotenv -e .env.development.local -o -- node scripts/database/run-local-prisma.mjs migrate dev",
    "db:pull": "dotenv -e .env.development.local -o -- node scripts/database/snapshot.mjs pull && npm run db:reset",
    "db:reset": "dotenv -e .env.development.local -o -- node scripts/database/snapshot.mjs restore && npm run db:apply && npm run db:bootstrap && npm run db:verify",
    "db:bootstrap": "dotenv -e .env.development.local -o -- tsx scripts/database/bootstrap-development-user.ts",
    "db:verify": "dotenv -e .env.development.local -o -- tsx scripts/database/verify-development-database.ts",
    "db:snapshot:publish": "dotenv -e .env.local -- node scripts/database/snapshot.mjs publish",
    "db:studio": "dotenv -e .env.development.local -o -- node scripts/database/run-local-prisma.mjs studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "knip": "^6.32.2",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
